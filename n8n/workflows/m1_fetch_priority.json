  "connections": {
    "Zeitplan: alle 5 Minuten": { "main": [ [ { "node": "M1: Prioritaetsquellen abrufen", "type": "main", "index": 0 } ] ] },
    "M1: Prioritaetsquellen abrufen": { "main": [ [ { "node": "Ein Eintrag je abgerufener Quelle", "type": "main", "index": 0 } ] ] }
